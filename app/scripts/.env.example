# Web3 configuration
# Local hardhat node (set RPC_URL empty + INFURA_API_KEY to use Sepolia on server)
RPC_URL=http://127.0.0.1:8545
INFURA_API_KEY=
# Hardhat account #0 (well-known dev key — DO NOT use on mainnet/testnet)
PRIVATE_KEY=
CONTRACT_ADDRESS=

# Encryption key for data encryption
ENCRYPTION_KEY=
# develop .env (behind proxy)
PORT=8000
ROOT_PATH=
BLOCKCHAIN_AUDIT=false

# other .env (direct access)
# PORT=8002
# ROOT_PATH=
