# Environment Variables for Web3DB Contract Deployment
# Copy this file to .env and fill in your actual values

# Infura API Key for Sepolia testnet
# Get your API key from: https://infura.io/
INFURA_API_KEY=your_infura_api_key_here

# Private key for deployment (64 hex characters, 32 bytes)
# IMPORTANT: Never commit your real private key to version control!
# Generate a test wallet or use a dedicated deployment wallet
# Example format: 1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef
PRIVATE_KEY=your_private_key_here

# Etherscan API Key for contract verification
# Get your API key from: https://etherscan.io/apis
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Note: For local testing, you don't need these environment variables
# The local Hardhat network will work without them
